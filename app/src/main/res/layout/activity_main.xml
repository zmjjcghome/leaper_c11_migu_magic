<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"> <!-- 垂直居中对齐，防止高度不一致时难看 -->
    
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="第一步：选择 APK 文件"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingEnd="2dp"/> <!-- 增加一点右边距，避免紧贴按钮 -->
    
        <Button
            android:id="@+id/btn_select_apk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择 APK 文件" />
        <Button
            android:id="@+id/btn_resign_apk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="重新签名APK"/>
    
    </LinearLayout>

    <TextView
        android:id="@+id/tv_selected_apk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:text="未选择文件"
        android:textColor="#666" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="第二步：设置监控目标路径"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_target_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="例：/storage/emulated/0/Download/name1.apk"
        android:inputType="textUri" />
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">
    
        <Button
            android:id="@+id/btn_toggle_monitor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="开始监控" />
    
        <Button
            android:id="@+id/btn_prepare_files"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="离谱安装1 准备文件" />
    
        <Button
            android:id="@+id/btn_execute_install"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="离谱安装2 执行安装" />
    
    </LinearLayout>

    <!-- <Button
        android:id="@+id/btn_toggle_monitor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="开始监控" />
    
     <Button
        android:id="@+id/btn_prepare_files"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="离谱安装1 准备文件" />

    <Button
        android:id="@+id/btn_execute_install"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="离谱安装2 执行安装"
         /> -->
    
    <ScrollView
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:padding="1dp">
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="状态：待机"
            android:textColor="#000"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </ScrollView>
    
<!--
        android:scrollbars="vertical"   开启竖直滚动条 
    android:scrollbarStyle="outsideOverlay"  滚动条悬浮在控件外侧，不挤压文本区域 
    android:overScrollMode="never"   关闭过度滚动的光晕效果 -->
    
    <ScrollView
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:scrollbars="vertical"
    android:scrollbarStyle="outsideOverlay"
    android:overScrollMode="never"
    android:background="#1A1A1A"
    android:padding="1dp">
        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:typeface="monospace"
            android:textIsSelectable="true"
            android:text="" />

    </ScrollView>
</LinearLayout>
